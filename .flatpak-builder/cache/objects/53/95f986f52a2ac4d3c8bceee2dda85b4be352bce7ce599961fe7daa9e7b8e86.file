{
  "id" : "com.github.pewmoe.cosmic-ext-ASCII-dot-battery",
  "runtime" : "org.freedesktop.Platform",
  "runtime-version" : "25.08",
  "runtime-commit" : "bd44a6230581917d04f89812a4c21090c304d390edb73995af1c2f9fd8abf4e8",
  "sdk" : "org.freedesktop.Sdk",
  "sdk-commit" : "b90ed309cc1d505dea48b6a2121c5dcfac22868120eee643b0596d31f96b9bb8",
  "build-options" : {
    "env" : {
      "CARGO_BUILD_JOBS" : "5",
      "CARGO_HOME" : "/run/build/cosmic-ext-ascii-dot-battery/cargo",
      "LOCKSTEP_XML_PATH" : "/run/build/cosmic-ext-ascii-dot-battery/vendor/atspi-common/xml"
    },
    "append-path" : "/usr/lib/sdk/rust-stable/bin"
  },
  "command" : "cosmic-ext-ascii-dot-battery",
  "modules" : [
    {
      "name" : "cosmic-ext-ascii-dot-battery",
      "buildsystem" : "simple",
      "sources" : [
        {
          "path" : "./",
          "type" : "dir"
        },
        {
          "path" : "vendor.tar",
          "type" : "file"
        }
      ],
      "build-commands" : [
        "tar pxf vendor.tar",
        "cargo build --release --frozen --offline",
        "install -Dm0755 target/release/cosmic-ext-ascii-dot-battery /app/bin/cosmic-ext-ascii-dot-battery",
        "install -Dm0644 target/xdgen/app.desktop /app/share/applications/com.github.pewmoe.cosmic-ext-ASCII-dot-battery.desktop",
        "install -Dm0644 target/xdgen/app.metainfo.xml /app/share/metainfo/com.github.pewmoe.cosmic-ext-ASCII-dot-battery.metainfo.xml",
        "install -Dm0644 resources/icon.svg /app/share/icons/hicolor/scalable/apps/com.github.pewmoe.cosmic-ext-ASCII-dot-battery.svg"
      ]
    }
  ],
  "sdk-extensions" : [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "finish-args" : [
    "--share=ipc",
    "--socket=wayland",
    "--device=dri",
    "--system-talk-name=net.hadess.PowerProfiles",
    "--system-talk-name=org.freedesktop.UPower",
    "--system-talk-name=org.freedesktop.login1",
    "--filesystem=/sys/class/backlight:ro",
    "--filesystem=xdg-config/cosmic:ro",
    "--filesystem=xdg-config/dconf:ro",
    "--env=DCONF_PROFILE=cosmic",
    "--filesystem=/usr/share/cosmic:ro",
    "--filesystem=/usr/share/fonts:ro",
    "--filesystem=xdg-data/fonts:ro"
  ],
  "source-date-epoch" : 1788091501
}